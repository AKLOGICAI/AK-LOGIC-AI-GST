# Copy this file to backend/.env and fill in real values. Never commit .env.

# ---------------- Core ----------------
# NOTE on OTP storage / login lockout / rate limiting: this state now lives
# in a small Postgres table (public.auth_rate_state) in the SAME database
# as DATABASE_URL below — see backend/app/rate_limit_repo.py. It is created
# automatically at startup if missing, and is also tracked as a migration
# at supabase/migrations/0009_auth_rate_state.sql. No new environment
# variables are required for this — it reuses DATABASE_URL.
# MUST be the Supabase project's direct Postgres connection using the
# `postgres` role — NOT the pgbouncer/anon/authenticated roles. That role
# has BYPASSRLS, which is what lets this backend read/write
# public.merchants after the anon-key RLS policies on that table were
# locked down (see supabase/migrations/0005_merchants_lockdown.sql).
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR-DB-PASSWORD@YOUR-PROJECT.supabase.co:5432/postgres

# Long random string — used to sign merchant/admin JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# "development" or "production". In production, JWT_SECRET, SECRET_KEY,
# ADMIN_PASSWORD_HASH and FRONTEND_ORIGIN are all required — the app
# refuses to start otherwise (see config.py's fail-fast check).
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins in production, e.g.
# https://app.example.com,https://example.com
FRONTEND_ORIGIN=

# bcrypt hash of the admin password. Leave blank in this file — generate
# your OWN hash per deployment and set it as a real environment variable
# (never commit the actual value to source control):
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

SECRET_KEY=

# ---------------- Razorpay (payment verification) ----------------
# Leave both blank to run with payment verification unavailable: any
# nonzero-price plan/add-on purchase will fail at /verify-payment with a
# 503 ("Payment gateway is not configured yet") rather than trusting an
# unverified client-supplied "it succeeded" flag. Set these once a real
# Razorpay account exists to accept real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------- MSG91 (OTP delivery) ----------------
# Leave both blank to run in OTP Development Mode (the code is generated
# randomly and returned in the /send-otp response instead of being sent by
# SMS — never available when ENVIRONMENT=production).
# MSG91_AUTH_KEY: MSG91 dashboard -> Settings -> API -> Auth Key.
# MSG91_TEMPLATE_ID: the approved "Send OTP" template id from MSG91.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Optional. 6-character DLT-approved sender id; when blank, MSG91 uses the
# sender configured on the template itself.
MSG91_SENDER_ID=

# Optional. TRAI/DLT identifiers (Entity ID and Template/Header ID). Most
# MSG91 accounts already have these tied to the template/sender and never
# need them set here — only fill these in if MSG91 support confirms your
# account requires them explicitly on every Send OTP API call.
MSG91_DLT_ENTITY_ID=
MSG91_DLT_TE_ID=

# Optional. Expiry (minutes) MSG91 is told to apply on its side. This
# backend's own OTP TTL (see backend/app/main.py) is unaffected and remains
# the source of truth for /verify-otp regardless of this value.
MSG91_OTP_EXPIRY_MINUTES=5

# ---------------- SMTP (Email OTP delivery) ----------------
# Leave SMTP_HOST blank to run without email OTP. The SAME code sent by
# MSG91 above is also emailed here -- added because the SMS channel has
# been unreliable in practice; email is now the dependable channel and
# SMS is best-effort. Any standard SMTP provider works (Gmail app
# password, Brevo/Sendinblue, Zoho Mail, Amazon SES SMTP, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional -- defaults to SMTP_USER when blank.
SMTP_FROM_EMAIL=

# ---------------- Web Push Notifications ----------------
# VAPID keys for web push notifications. Generate keys using:
#   python -c "from pywebpush import vapid; keys = vapid.generate_keys(); print('VAPID_PUBLIC_KEY =', keys['public_key']); print('VAPID_PRIVATE_KEY =', keys['private_key'])"
# VAPID_SUBJECT must be a mailto: email address or website URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
